# Modo atrás de proxy (CO_TI_ATRAS_DE_PROXY=true, ex.: Traefik do Coolify): o proxy termina o HTTPS e repassa tudo em
# HTTP para cá. 15-modo-proxy.sh troca o default.conf.template (HTTPS próprio) por este na subida.
server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 50m;

    # Neste modo o contêiner não publica porta no host: só o proxy (redes do Docker) chega aqui. O realip troca $remote_addr
    # pelo IP que o proxy acrescentou no X-Forwarded-For, e o portal.conf/agentes.conf repassam esse IP ao backend.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /usr/share/nginx/html;

    include /etc/nginx/coti/agentes.conf;
    include /etc/nginx/coti/portal.conf;
}
