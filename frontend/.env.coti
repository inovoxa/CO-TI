# CO-TI — build de produção servido pelo nginx no mesmo domínio da API (sem CORS)
NODE_ENV=production
VITE_DEV=false

VITE_APP_TITLE=Centro de Operações de TI

# Mesmo domínio: o nginx encaminha /admin-api e /infra/ws para o backend
VITE_BASE_URL=''
VITE_API_URL=/admin-api
VITE_UPLOAD_TYPE=server

# Single-tenant: uma instalação por empresa
VITE_APP_TENANT_ENABLE=false
VITE_APP_DEFAULT_LOGIN_TENANT=
VITE_APP_CAPTCHA_ENABLE=true

# Sem analytics de terceiros nem credenciais de exemplo no bundle
VITE_APP_DEFAULT_LOGIN_USERNAME=
VITE_APP_DEFAULT_LOGIN_PASSWORD=

# A criptografia de payload do yudao fica desligada (backend também): o transporte é TLS
VITE_APP_API_ENCRYPT_ENABLE=false

VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_COMPRESS=gzip
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-coti
VITE_MALL_H5_DOMAIN=
VITE_GOVIEW_URL=
