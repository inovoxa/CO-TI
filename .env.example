# Copie para .env e troque TODOS os valores. Gere senhas com:  openssl rand -base64 32
# Dono das tabelas (usado só pelas migrations) e papel da aplicação (só leitura/escrita de dados)
CO_TI_DB_PASSWORD=troque-esta-senha
CO_TI_DB_APP_PASSWORD=troque-esta-senha
CO_TI_REDIS_PASSWORD=troque-esta-senha
CO_TI_ADMIN_MONITOR_PASSWORD=troque-esta-senha
CO_TI_HTTP_PORT=8080
# HTTPS: o portal só abre por aqui (o HTTP redireciona; agentes de inventário e push seguem nos dois).
# Certificado da empresa em ./segredos/tls (cert.pem com a cadeia, key.pem); sem ele, gera um autoassinado.
CO_TI_HTTPS_PORT=8443
# Nomes e IPs do autoassinado, separados por vírgula (ex.: coti.pma.local,10.0.1.20)
CO_TI_TLS_NOMES=
# Fuso da empresa (expediente e prazos de SLA)
CO_TI_FUSO=America/Sao_Paulo
# Chave-mestra dos segredos cifrados (MFA, cofre): openssl rand -base64 32 — guarde cópia segura fora do servidor
CO_TI_CHAVE_MESTRA=
# Nome que aparece no aplicativo autenticador
CO_TI_MFA_EMISSOR=CO-TI
# Ver senhas do cofre exige a verificação em duas etapas ativa na conta de quem vê
CO_TI_COFRE_EXIGIR_MFA=true
# false só em laboratório
CO_TI_CAPTCHA=true
# Imagem do PostgreSQL (TimescaleDB + pgvector). Atualize testando antes.
# CO_TI_PG_IMAGE=timescale/timescaledb-ha:pg16.15-ts2.30.1

# Primeira partida: senha do administrador local (mínimo 12). Depois de entrar, remova esta linha.
CO_TI_ADMIN_SENHA_INICIAL=

# Active Directory (deixe false até configurar)
CO_TI_AD_HABILITADO=false
CO_TI_AD_URL=ldaps://dc01.empresa.local:636
CO_TI_AD_BIND_DN=CN=svc-coti,OU=Servicos,DC=empresa,DC=local
CO_TI_AD_BIND_SENHA=
CO_TI_AD_BASE_USUARIOS=OU=Empresa,DC=empresa,DC=local
# Membros deste grupo do AD aprovam pedidos (CN ou DN; vários separados por ";"). Também aprova quem tiver o papel
# "Aprovador" dado à mão no portal. Ninguém mais aprova.
CO_TI_AD_GRUPO_APROVADORES=

# Execução no AD dos pedidos do catálogo (criar usuário, resetar senha...): desligado | simulado | ssh
# Com ssh, coloque a chave privada em ./segredos/ad_ssh_key (a pasta não vai para o git).
CO_TI_AD_EXECUCAO=desligado
CO_TI_AD_SSH_HOST=
CO_TI_AD_SSH_USUARIO=
CO_TI_AD_SSH_IMPRESSAO=

# Retenção dos registros técnicos, em dias (0 = guardar para sempre). Chamados, conversas, inventário e a trilha de
# auditoria não entram aqui: ficam sempre.
CO_TI_RETENCAO_LOG_OPERACOES_DIAS=730
CO_TI_RETENCAO_LOG_ACESSO_DIAS=365
CO_TI_RETENCAO_LOG_API_DIAS=30
CO_TI_RETENCAO_LOG_ERROS_DIAS=90

# Logs centralizados: portas no servidor (aponte o FortiGate, o NXLog/Winlogbeat e os servidores para elas),
# quem pode mandar (redes separadas por vírgula; vazio = todos) e dias guardados.
CO_TI_SYSLOG_PORTA=514
CO_TI_GELF_PORTA=12201
CO_TI_LOGS_PERMITIDOS=
CO_TI_LOGS_RETENCAO_DIAS=30

# Mais de uma instância do backend: "redis" faz os avisos ao vivo chegarem a quem está conectado em qualquer uma.
CO_TI_WS_SENDER=local

# Endereço público do CO-TI, com HTTPS. Os provedores (Meta, Telegram) mandam os webhooks para cá, e os links dos
# anexos são montados a partir dele.
CO_TI_URL_PUBLICA=https://ti.empresa.gov.br

# Backup diário do banco e dos anexos em ./backups (serviço "backup"); copie a pasta para fora do servidor
CO_TI_BACKUP_HORA=02:30
CO_TI_BACKUP_DIAS=14

# Rede interna dos containers: não pode colidir com faixas da rede monitorada (as unidades usam 10.x e 172.16-31.x)
CO_TI_REDE_DOCKER=192.168.240.0/24
