# Copie para .env e troque TODOS os valores. Gere senhas com:  openssl rand -base64 32
# Dono das tabelas (usado só pelas migrations) e papel da aplicação (só leitura/escrita de dados)
CO_TI_DB_PASSWORD=troque-esta-senha
CO_TI_DB_APP_PASSWORD=troque-esta-senha
CO_TI_REDIS_PASSWORD=troque-esta-senha
CO_TI_ADMIN_MONITOR_PASSWORD=troque-esta-senha
CO_TI_HTTP_PORT=8080
# Fuso da empresa (expediente e prazos de SLA)
CO_TI_FUSO=America/Sao_Paulo
# Chave-mestra dos segredos cifrados (MFA, cofre): openssl rand -base64 32 — guarde cópia segura fora do servidor
CO_TI_CHAVE_MESTRA=
# Nome que aparece no aplicativo autenticador
CO_TI_MFA_EMISSOR=CO-TI
# false só em laboratório
CO_TI_CAPTCHA=true
# Imagem do PostgreSQL (TimescaleDB + pgvector). Atualize testando antes.
# CO_TI_PG_IMAGE=timescale/timescaledb-ha:pg16.15-ts2.30.1

# Primeira partida: senha do administrador local (mínimo 12). Depois de entrar, remova esta linha.
CO_TI_ADMIN_SENHA_INICIAL=

# Active Directory (deixe false até configurar)
CO_TI_AD_HABILITADO=false
CO_TI_AD_URL=ldaps://dc01.empresa.local:636
CO_TI_AD_BIND_DN=CN=svc-coti,OU=Servicos,DC=empresa,DC=local
CO_TI_AD_BIND_SENHA=
CO_TI_AD_BASE_USUARIOS=OU=Empresa,DC=empresa,DC=local

# Execução no AD dos pedidos do catálogo (criar usuário, resetar senha...): desligado | simulado | ssh
# Com ssh, coloque a chave privada em ./segredos/ad_ssh_key (a pasta não vai para o git).
CO_TI_AD_EXECUCAO=desligado
CO_TI_AD_SSH_HOST=
CO_TI_AD_SSH_USUARIO=
CO_TI_AD_SSH_IMPRESSAO=
